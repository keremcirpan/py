import plotly.graph_objects as go

# Sample data for FX performance year to date (YTD) for multiple currencies (percentage changes)
currency_data = {
    "MXN": [0.5, 1.2, 1.8, 2.5, 3.1, 3.7, 4.0, 3.8, 4.2, 4.5],
    "CNH": [-0.3, -0.8, -1.2, -1.5, -1.7, -1.9, -2.0, -2.1, -2.3, -2.5],
    "EUR": [0.1, 0.3, 0.6, 0.4, 0.7, 1.0, 1.2, 1.5, 1.8, 2.0],
    "JPY": [-0.5, -0.3, -0.2, 0.0, 0.2, 0.5, 0.7, 0.9, 1.0, 1.2],
    "GBP": [0.4, 0.7, 1.1, 1.5, 1.9, 2.1, 2.3, 2.5, 2.7, 3.0],
}

dates = ["2024-01", "2024-02", "2024-03", "2024-04", "2024-05", "2024-06", "2024-07", "2024-08", "2024-09", "2024-10"]

# Create the plotly figure
fig = go.Figure()

# Add a line for each currency
for currency, performance in currency_data.items():
    text_labels = [''] * (len(performance) - 1) + [currency]
    fig.add_trace(go.Scatter(
        x=dates, y=performance, mode='lines+markers+text',
        name=currency, text=[currency]*len(dates), textposition='top right'
    ))

# Update layout for better visualization
fig.update_layout(
    title='FX Performance Year to Date (2024) for Multiple Currencies',
    xaxis_title='Date',
    yaxis_title='Performance (%)',
    xaxis=dict(tickangle=-45),
    legend_title='Currencies',
    template='plotly_white'
)

# Show the chart
fig.show()
